<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimpleList.Pages.DriveTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <TabView x:Name="DriveTabView"
                 Grid.Row="0"
                 IsAddTabButtonVisible="False"
                 TabCloseRequested="DriveTabView_TabCloseRequested"
                 SelectionChanged="DriveTabView_SelectionChanged"
                 VerticalAlignment="Top"
                 TabWidthMode="SizeToContent" />

        <!-- Navigation toolbar: Back, Forward, Refresh (hidden for CloudPage tab) -->
        <Grid x:Name="NavBar" Grid.Row="1" Padding="10 6 10 4" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Click="BackButton_Click"
                    IsEnabled="False"
                    Padding="8 6"
                    Margin="0 0 4 0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind BackTooltip}">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>

            <Button x:Name="ForwardButton"
                    Grid.Column="1"
                    Click="ForwardButton_Click"
                    IsEnabled="False"
                    Padding="8 6"
                    Margin="0 0 4 0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind ForwardTooltip}">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>

            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Click="RefreshButton_Click"
                    Padding="8 6"
                    Margin="0 0 8 0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind RefreshTooltip}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Content area: each tab has its own Frame, we swap visibility -->
        <Grid x:Name="FrameContainer" Grid.Row="2" />
    </Grid>
</Page>
